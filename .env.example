# Banco PostgreSQL (local ou Supabase/Neon). No Supabase use a URL "pooler" em DATABASE_URL
# e a conexão direta em DIRECT_URL (usada pelas migrations).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/controle_os"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/controle_os"

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_SECRET=""

# Endereço público do sistema (usado no link de confirmação e no QR code do PDF)
APP_URL="http://localhost:3000"

# Onde guardar fotos, assinaturas, NFs e comprovantes: "local" (pasta ./storage) ou "supabase"
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="arquivos"

# Dados da empresa que aparecem no PDF e nas mensagens
EMPRESA_NOME="Minha Empresa"
EMPRESA_CNPJ=""
EMPRESA_TELEFONE=""
EMPRESA_ENDERECO=""
